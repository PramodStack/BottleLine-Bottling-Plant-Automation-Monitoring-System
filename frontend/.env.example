# ==============================================================================
# BOTTLING PLANT FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local or .env in the frontend directory:
#   cp .env.example .env
# ==============================================================================

# Backend API Base URL (default is empty for relative /api proxy in Vite dev server)
VITE_API_URL=http://localhost:5000

# Optional WebSocket / Telemetry Polling Rate (milliseconds)
VITE_TELEMETRY_POLL_INTERVAL=4000

